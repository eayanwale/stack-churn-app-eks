# ------------------------------------------------------------------
# Copy to .env and edit. The app reads these at startup.
# ------------------------------------------------------------------

# How to run inference:  local  = bundled model file (default)
#                        aws    = call a SageMaker endpoint
INFERENCE_MODE=local

# --- local mode -------------------------------------------------
# Path to the bundled model (defaults to model/churn_model.joblib)
# MODEL_PATH=model/churn_model.joblib

# --- aws mode ---------------------------------------------------
# SAGEMAKER_ENDPOINT_NAME=stackit-churn-endpoint
# AWS_REGION=us-east-1
# Credentials come from the EC2 instance's IAM role (preferred),
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if you must.

# Classification threshold (probability at/above which = "will churn")
CHURN_THRESHOLD=0.5

# Port the app listens on inside the container
PORT=8080
